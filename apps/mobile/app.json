{
  "expo": {
    "name": "Pocket Tools",
    "slug": "pocket-tools",
    "scheme": "pocket-tools",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-dev-client",
      "./plugins/with-short-cmake-staging.cjs",
      "./plugins/with-arm64-release-optimization.cjs"
    ],
    "android": {
      "package": "com.darbyjack.pockettools",
      "permissions": ["android.permission.SCHEDULE_EXACT_ALARM"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#EEF1F5"
      }
    }
  }
}
