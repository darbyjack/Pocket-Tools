{
  "name": "pocket-tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "android": "pnpm sync:examples && pnpm --dir apps/mobile android",
    "check": "pnpm sync:examples:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "sync:examples": "node scripts/sync-example-source.mjs",
    "sync:examples:check": "node scripts/sync-example-source.mjs --check",
    "test": "node --experimental-strip-types --test packages/sdk-contract/src/*.test.ts apps/mobile/src/runtime/*.test.ts",
    "typecheck": "tsc --noEmit && pnpm --dir apps/mobile typecheck && pnpm --dir modules/pocket-quickjs typecheck"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "typescript": "7.0.2"
  }
}
