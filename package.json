{
  "name": "pocket-tools",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "android": "pnpm sync:mini-apps && pnpm --dir apps/mobile android",
    "check": "pnpm sync:mini-apps:check && pnpm sdk:declarations:check && pnpm docs:sync:check && pnpm docs:links && pnpm legal:notices:check && pnpm licenses:check && pnpm sbom:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "docs:sync": "node scripts/sync-docs-site.mjs write",
    "docs:sync:check": "node scripts/sync-docs-site.mjs check",
    "docs:dev": "pnpm docs:sync && pnpm --dir apps/docs dev",
    "docs:build": "pnpm sdk:declarations:check && pnpm docs:sync && pnpm docs:links && pnpm --dir apps/docs build",
    "docs:preview": "pnpm --dir apps/docs preview",
    "docs:links": "node scripts/check-docs-links.mjs",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "inspect:mini-app": "pnpm --dir packages/authoring-tools mini-app inspect",
    "legal:notices:check": "node scripts/sync-legal-notices.mjs check",
    "legal:notices:write": "node scripts/sync-legal-notices.mjs write",
    "licenses:android:check": "node scripts/license-inventory.mjs android:check",
    "licenses:android:write": "node scripts/license-inventory.mjs android:write",
    "licenses:check": "node scripts/license-inventory.mjs check",
    "licenses:pnpm:check": "node scripts/license-inventory.mjs pnpm:check",
    "licenses:pnpm:write": "node scripts/license-inventory.mjs pnpm:write",
    "lint": "oxlint .",
    "mini-app": "pnpm --dir packages/authoring-tools mini-app",
    "release:android:build": "node scripts/android-release-build.mjs build-one",
    "release:android:build-all": "node scripts/android-release-build.mjs build-all",
    "release:android:certificate": "node scripts/android-release.mjs certificate",
    "release:android:inspect": "node scripts/android-release.mjs inspect",
    "release:android:sign": "node scripts/android-release.mjs sign",
    "release:android:test-key": "node scripts/android-release.mjs test-key",
    "release:android:tools": "node scripts/android-release.mjs tools",
    "release:checksums": "node scripts/release-engineering.mjs checksums",
    "release:plan": "node scripts/release-engineering.mjs plan",
    "release:stage": "node scripts/release-stage.mjs stage",
    "release:validate": "node scripts/release-engineering.mjs validate-inputs",
    "release:verify": "node scripts/release-engineering.mjs verify-directory",
    "sbom:check": "node scripts/spdx-sbom.mjs check",
    "sbom:write": "node scripts/spdx-sbom.mjs write",
    "sdk:declarations": "node --experimental-strip-types packages/authoring-tools/src/declarations.ts write",
    "sdk:declarations:check": "node --experimental-strip-types packages/authoring-tools/src/declarations.ts check",
    "sync:mini-apps": "node scripts/sync-bundled-mini-apps.mjs",
    "sync:mini-apps:check": "node scripts/sync-bundled-mini-apps.mjs --check",
    "test": "node --experimental-strip-types --test scripts/*.test.mjs packages/sdk-contract/src/*.test.ts packages/authoring-tools/src/*.test.ts apps/mobile/src/acceptance/*.test.ts apps/mobile/src/installer/*.test.ts apps/mobile/src/runtime/*.test.ts apps/mobile/src/storage/*.test.ts apps/mobile/src/notifications/*.test.ts modules/pocket-quickjs/src/*.test.ts modules/pocket-notifications/src/*.test.ts",
    "typecheck": "tsc --noEmit && pnpm --dir apps/mobile typecheck && pnpm --dir modules/pocket-quickjs typecheck && pnpm --dir modules/pocket-notifications typecheck",
    "validate:mini-app": "pnpm --dir packages/authoring-tools mini-app validate"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "packageManager": "pnpm@11.17.0"
}
